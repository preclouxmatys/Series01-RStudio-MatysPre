# Boxplot de la variable Weight with chat gpt
plot(data$Weight, data$Height,
main = "Relation entre le poids et la taille",
xlab = "Poids (kg)",
ylab = "Taille (cm)",
pch = 19,                # Points pleins
col = "blue")
# Ajout de la droite de régression (modèle linéaire)
model <- lm(Height ~ Weight, data = data)
abline(model, col = "red", lwd = 2)
